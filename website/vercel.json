{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/share",
      "permanent": true
    },
    {
      "source": "/usage",
      "destination": "/commands",
      "permanent": true
    }
  ]
}
