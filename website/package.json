{
  "name": "tailscale-proxy-website",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for tailscale-proxy (TanStack Start, prerendered, deployed on Vercel).",
  "type": "module",
  "scripts": {
    "build": "bun scripts/gen-llms.ts && bun --bun vite build && pagefind --site dist/client",
    "dev": "bun scripts/gen-llms.ts && bun --bun vite dev",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "preview": "bun --bun vite preview",
    "typecheck": "bun check",
    "gen:llms": "bun scripts/gen-llms.ts"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@theguild/remark-mermaid": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "^1.4.5",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "pagefind": "^1.6.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.4.0"
  },
  "overrides": {
    "mermaid": "^12.4.0"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}
