{
  "name": "tailscale-proxy-website",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for tailscale-proxy (Nextra + Next.js, deployed on Vercel).",
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build",
    "export": "next build",
    "start": "next start",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind || true"
  },
  "dependencies": {
    "@theguild/remark-mermaid": "^0.3.0",
    "next": "^16.3.5",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.0",
    "@types/react": "^19.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
